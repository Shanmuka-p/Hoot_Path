<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow aihoot.in:5001 even with self-signed / expired SSL cert -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">aihoot.in</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>

    <!-- Render server (valid cert, strict by default) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">hoot-path.onrender.com</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
