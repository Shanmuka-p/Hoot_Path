# Environment Variables — Hoot Path Server
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# On Render: set these in Dashboard → Environment (not in render.yaml).
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=

# Server port (Render sets this automatically; use 5001 locally)
PORT=5001

# OpenRouter API keys (comma-separated, no spaces)
# Get free keys at: https://openrouter.ai → Sign in → Keys
# Add multiple keys so the server automatically rotates when one hits its limit.
# Example: OPENROUTER_KEYS=sk-or-v1-abc123,sk-or-v1-def456,sk-or-v1-ghi789
OPENROUTER_KEYS=

# (Optional) Override the default free model list with comma-separated model IDs
# Default order: llama-3.1-8b → mistral-7b → gemma-3-12b → deepseek → phi-3
# OPENROUTER_MODELS=meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free
OPENROUTER_MODELS=
