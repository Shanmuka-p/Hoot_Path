# Environment Variables — Hoot Path Server
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# On Render: set these in Dashboard → Environment (not in render.yaml).
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGO_URI=

# Server port (Render sets this automatically; use 5001 locally)
PORT=5001
